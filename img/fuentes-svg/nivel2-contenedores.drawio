="610" y="230"/></Array></mxGeometry></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:12px&quot;&gt;API Marketplace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#E6E6E6&quot;&gt;[Contenedor: Node.js + Express]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Monolito modular. Expone la API REST, aplica las reglas de negocio e integra los sistemas externos&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="450" width="280" height="210" as="geometry"/></mxCell><mxCell id="c18" value="Llama a la API&lt;br&gt;[HTTPS/JSON]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:12px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#E6E6E6&quot;&gt;[Contenedor: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Usuarios, sellers, productos, carritos y pedidos&lt;/font&gt;" style="fontFamily=Helvetica;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="730" width="190" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:12px&quot;&gt;Caché&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#E6E6E6&quot;&gt;[Contenedor: Redis]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Catálogo de productos en memoria&lt;/font&gt;"